{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Iacobar",
  "version": "0.1.0",
  "identifier": "app.iacobar",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "flyout",
        "url": "/flyout",
        "title": "Iacobar Flyout",
        "width": 360,
        "height": 420,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "visible": false,
        "backgroundColor": "#00000000",
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --renderer-process-limit=1"
      },
      {
        "label": "preview",
        "url": "/preview",
        "title": "Iacobar Preview",
        "width": 480,
        "height": 220,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "visible": false,
        "focus": false,
        "backgroundColor": "#00000000",
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --renderer-process-limit=1"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "IacoM",
    "shortDescription": "A modern, customizable taskbar for Windows",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Italian"
        ],
        "installerHooks": "./windows-hooks.nsh"
      }
    }
  }
}