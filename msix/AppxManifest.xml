<?xml version="1.0" encoding="utf-8"?>
<!--
  Microsoft Store package (MSIX). scripts\release.ps1 fills the {{...}} values
  from msix\store.json (identity reserved in Partner Center) and the version
  from tauri.conf.json, then packs it with iacobar.exe and the logos.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap desktop rescap">

  <Identity
    Name="{{IDENTITY_NAME}}"
    Publisher="{{PUBLISHER}}"
    Version="{{VERSION}}.0"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Iacobar</DisplayName>
    <PublisherDisplayName>{{PUBLISHER_DISPLAY_NAME}}</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.22000.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="it-IT" />
  </Resources>

  <Applications>
    <Application Id="Iacobar" Executable="iacobar.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Iacobar"
        Description="Una barra delle applicazioni moderna e leggera per Windows 11"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />
      <Extensions>
        <!-- "Avvia con Windows": the app turns it on or off to match its setting -->
        <desktop:Extension Category="windows.startupTask" Executable="iacobar.exe" EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask TaskId="IacobarStartup" Enabled="false" DisplayName="Iacobar" />
        </desktop:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <!-- a desktop (Win32) app: it hides the Windows taskbar and talks to other apps' windows -->
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
